# =============================================================================
# TAC Microsoft — Environment Variables
# =============================================================================
# All examples load from this shared .env file.
# From the repo root, copy to .env and fill in your values:
#   cp getting_started/examples/.env.example getting_started/examples/.env

# ---------------------------------------------------------------------------
# Twilio Agent Connect (required for all examples)
# ---------------------------------------------------------------------------
TWILIO_CONVERSATION_CONFIGURATION_ID=conv_configuration_xxxxxxxxxxxxxxxxxx
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your_api_key_secret
TWILIO_PHONE_NUMBER=+1234567890

# Optional messaging channels (advanced example). Setting either of these
# auto-enables the corresponding channel on AgentFrameworkConnector.
# TWILIO_RCS_SENDER_ID=rcs_sender_xxxxxxxxxxxxxxxxxx
# TWILIO_WHATSAPP_NUMBER=+1234567890

# ---------------------------------------------------------------------------
# TAC Server (required for voice)
# ---------------------------------------------------------------------------
TWILIO_VOICE_PUBLIC_DOMAIN=your-domain.ngrok.io
# TWILIO_SERVER_HOST=0.0.0.0
# TWILIO_SERVER_PORT=8000

# ---------------------------------------------------------------------------
# Azure OpenAI — Agent Framework (agent_framework/basic.py)
# Endpoint must be the resource base URL only — do NOT include /openai/v1 or
# any other path. If you copy from the Foundry portal, strip the trailing path.
# ---------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_AI_API_KEY=your_azure_openai_api_key
AZURE_AI_DEPLOYMENT_NAME=gpt-4o

# ---------------------------------------------------------------------------
# Agent Framework — advanced example (agent_framework/advanced.py)
# Uses the same AZURE_OPENAI_ENDPOINT as basic.py, but authenticates via
# DefaultAzureCredential — run `az login` first.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Azure AI — Voice Live (voice_live/basic.py)
# Endpoint is the hostname only, no https:// prefix.
# ---------------------------------------------------------------------------
# AZURE_VOICE_LIVE_ENDPOINT=your-resource.services.ai.azure.com
# AZURE_VOICE_LIVE_API_KEY=your_voice_live_api_key
# AZURE_VOICE_LIVE_MODEL=gpt-realtime

# ---------------------------------------------------------------------------
# Azure Cosmos DB — CosmosDBAgentSessionStore (agent_framework/advanced.py)
# ---------------------------------------------------------------------------
# AZURE_COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
# AZURE_COSMOS_KEY=your_cosmos_key

# ---------------------------------------------------------------------------
# TAC optional features (agent_framework/advanced.py)
# ---------------------------------------------------------------------------
# TWILIO_KNOWLEDGE_BASE_ID=know_knowledgebase_xxxxxxxxxxxxxxxxxx
# TWILIO_LOG_LEVEL=INFO
# MEMORY_PROFILE_TRAIT_GROUPS=Contact,Preferences

# ---------------------------------------------------------------------------
# TAC Conversation Intelligence (optional)
# ---------------------------------------------------------------------------
# CONVERSATION_INTELLIGENCE_CONFIGURATION_ID=GAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CONVERSATION_INTELLIGENCE_OBSERVATION_OPERATOR_SID=LYxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CONVERSATION_INTELLIGENCE_SUMMARY_OPERATOR_SID=LYxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
