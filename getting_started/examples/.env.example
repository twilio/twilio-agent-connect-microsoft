# =============================================================================
# TAC Azure — Environment Variables
# =============================================================================

# ---------------------------------------------------------------------------
# Twilio Agent Connect (required)
# ---------------------------------------------------------------------------
TWILIO_TAC_CONVERSATION_CONFIGURATION_ID=conv_configuration_xxxxxxxxxxxxxxxxxx
TWILIO_TAC_AUTH_TOKEN=your_auth_token
TWILIO_TAC_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TAC_API_TOKEN=your_api_key_secret
TWILIO_TAC_PHONE_NUMBER=+1234567890

# ---------------------------------------------------------------------------
# TAC Server (required for voice)
# ---------------------------------------------------------------------------
TWILIO_TAC_VOICE_PUBLIC_DOMAIN=your-domain.ngrok.io
# TWILIO_TAC_SERVER_HOST=0.0.0.0
# TWILIO_TAC_SERVER_PORT=8000

# ---------------------------------------------------------------------------
# Azure AI — Agent Framework examples (agent_framework/)
# ---------------------------------------------------------------------------
AZURE_AI_PROJECT_ENDPOINT=https://your-project.openai.azure.com/
# AZURE_AI_DEPLOYMENT_NAME=gpt-4o

# ---------------------------------------------------------------------------
# Azure AI — Voice Live examples (voice_live/)
# ---------------------------------------------------------------------------
# AZURE_VOICE_LIVE_ENDPOINT=your-resource.services.ai.azure.com (no https:// prepended)
# AZURE_VOICE_LIVE_API_KEY=your_voice_live_api_key
# AZURE_VOICE_LIVE_MODEL=gpt-realtime

# ---------------------------------------------------------------------------
# Azure Cosmos DB — CosmosDBAgentSessionStore (optional)
# ---------------------------------------------------------------------------
# AZURE_COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
# AZURE_COSMOS_KEY=your_cosmos_key

# ---------------------------------------------------------------------------
# TAC optional features
# ---------------------------------------------------------------------------
# TWILIO_TAC_KNOWLEDGE_BASE_ID=know_knowledgebase_xxxxxxxxxxxxxxxxxx
# TWILIO_TAC_LOG_LEVEL=INFO
# TWILIO_TAC_TRAIT_GROUPS=Contact,Preferences

# ---------------------------------------------------------------------------
# TAC Conversation Intelligence (optional)
# ---------------------------------------------------------------------------
# TWILIO_TAC_CI_CONFIGURATION_ID=GAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_TAC_CI_OBSERVATION_OPERATOR_SID=LYxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_TAC_CI_SUMMARY_OPERATOR_SID=LYxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
