# Twilio credentials (required for TAC)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_PHONE_NUMBER=
TWILIO_CONVERSATION_CONFIGURATION_ID=

# Azure OpenAI (required)
# Resource base URL only — no /openai/v1 or other path suffix.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
# Name of the Azure AI / Cognitive Services account (for RBAC role assignment)
AZURE_OPENAI_ACCOUNT_NAME=
# Optional: resource group of the AI account (defaults to the deployment RG)
# AZURE_OPENAI_ACCOUNT_RESOURCE_GROUP=

# azd deployment target
AZURE_LOCATION=eastus2

# TAC options (optional)
# TWILIO_KNOWLEDGE_BASE_ID=
# TWILIO_LOG_LEVEL=INFO
