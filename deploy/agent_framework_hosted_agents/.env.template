# You usually don't edit this file by hand — just run `make deploy`.
# It creates .env from this template, prompts for any required values, and
# derives all resource names from a single slug (so every deployment is
# independent, globally unique, and works the first time). Editing values
# here ahead of time just skips the matching prompt.
#
# `make deploy` then creates/selects the azd environment, loads these values,
# provisions everything fresh (Foundry account + project + model + container
# registry + APIM + Key Vault), and pushes the agent.

# ---- Identity / target -------------------------------------------------
# DEPLOY_SLUG is a ONE-TIME bootstrap field. Use first initial + last name
# (e.g. John Smith -> jsmith), lowercase letters/numbers only. On first deploy,
# the resource names below are generated from it (+ a stable hash for global
# uniqueness) and written into this file as raw values; the slug is then
# CONSUMED (removed). After that, the names below are the source of truth. Two
# people with different slugs never collide; re-running updates the SAME stack.
# Prompted if empty (defaults to your sign-in name as jsmith).
DEPLOY_SLUG=
# Subscription to deploy into. Prompted (defaults to your current az sub).
AZURE_SUBSCRIPTION_ID=
# Region. Hosted Agents is region-limited; northcentralus is known-good.
AZURE_LOCATION=northcentralus

# Generated from DEPLOY_SLUG on first deploy (azd env = tac-<slug>, RG =
# rg-tac-<slug>, APIM = tac-<slug>-<hash>, project = tac-<slug>-project) and
# then authoritative. Set them yourself to use custom names instead. To
# regenerate from a new slug, clear these and set DEPLOY_SLUG again.
AZURE_ENV_NAME=
AZURE_RESOURCE_GROUP=
APIM_NAME=
HOSTED_AGENTS_PROJECT_NAME=

# ---- Twilio (REQUIRED — prompted if empty) -----------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_PHONE_NUMBER=
TWILIO_CONVERSATION_CONFIGURATION_ID=

# ---- APIM / agent ------------------------------------------------------
# Publisher email is prompted (defaults to your az sign-in) if empty.
APIM_PUBLISHER_EMAIL=
APIM_PUBLISHER_NAME=Twilio Agent
# Agent name must match agent.yaml `name:`.
HOSTED_AGENTS_AGENT_NAME=tac-agent-framework

# ---- Optional --------------------------------------------------------------
TWILIO_KNOWLEDGE_BASE_ID=
APIM_SKU=BasicV2

# Fresh Foundry tuning (sensible defaults; override only if needed).
# MODEL_CAPACITY is kept low so a fresh subscription quota doesn't block the
# model deployment; raise as quota allows.
# FOUNDRY_ACCOUNT_NAME=
# CONTAINER_REGISTRY_NAME=
# FOUNDRY_LOCATION=northcentralus
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.4-mini
# MODEL_VERSION=2026-03-17
# MODEL_SKU_NAME=GlobalStandard
# MODEL_CAPACITY=50

# Some tenants enforce purge protection on Key Vaults. Defaults to true
# (compatible with strict tenants); once enabled the vault has the full
# 90-day soft-delete retention and cannot be purged early. Set false only in
# dev tenants where you want fast teardown.
KEY_VAULT_PURGE_PROTECTION=true

# ============================================================================
# BRING-YOUR-OWN mode (advanced) — only if you do NOT want fresh resources.
# Set CREATE_FOUNDRY=false and supply an existing Foundry project + ACR.
# ============================================================================
# CREATE_FOUNDRY=false
#
# Existing Foundry project (the agent's protocols path — must end at
# /endpoint/protocols):
#   https://<account>.services.ai.azure.com/api/projects/<project>/agents/<agent>/endpoint/protocols
# HOSTED_AGENTS_URL=
# AZURE_AI_PROJECT_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<account>/projects/<project>
# FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
# AZURE_CONTAINER_REGISTRY_ENDPOINT=<account-acr>.azurecr.io
# AZURE_OPENAI_ENDPOINT=https://<account>.openai.azure.com
# AZURE_OPENAI_API_KEY=
#
# Reuse an existing Key Vault instead of creating one (must already contain a
# secret named `TwilioAuthToken`); set RG if it's not in AZURE_RESOURCE_GROUP.
# When reusing a vault where APIM's MI already has the role, also set
# SKIP_KEY_VAULT_ROLE_ASSIGNMENT=true.
# EXISTING_KEY_VAULT_NAME=
# EXISTING_KEY_VAULT_RESOURCE_GROUP=
# SKIP_KEY_VAULT_ROLE_ASSIGNMENT=false
