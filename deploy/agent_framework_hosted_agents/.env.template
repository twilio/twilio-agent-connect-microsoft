# Copy to .env and fill in. The preprovision hook in azure.yaml imports
# this into the azd environment so Bicep + agent.yaml resolve cleanly.
#
# IMPORTANT: the preprovision hook re-imports this file on every `azd up`,
# overwriting any `azd env set` you ran by hand between runs. Edit the
# file itself to make changes durable.

# ---- Azure OpenAI (existing account) -----------------------------------
AZURE_OPENAI_ENDPOINT=https://<your-account>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# ---- Twilio (canonical TAC 1.0+ names) ---------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_PHONE_NUMBER=
TWILIO_CONVERSATION_CONFIGURATION_ID=

# ---- Voice (set after first APIM deployment, then re-azd-up) -----------
# Format: <apim>.azure-api.net/<api-path>. With the default Bicep API
# path of "twilio", this is e.g. "my-tac-apim.azure-api.net/twilio".
# The server emits wss URLs as wss://<this>/ws?agent_session_id=...
TWILIO_VOICE_PUBLIC_DOMAIN=

# ---- Optional ----------------------------------------------------------
TWILIO_KNOWLEDGE_BASE_ID=

# ---- APIM Bicep parameters ---------------------------------------------
APIM_NAME=
APIM_PUBLISHER_EMAIL=admin@example.com
APIM_PUBLISHER_NAME=Twilio Agent
APIM_SKU=BasicV2

# Foundry — fill in after `azd up` provisions the agent.
#
# CRITICAL: HOSTED_AGENTS_URL must be the agent's *protocols* path, not
# the bare account root. The SMS policy rewrites the URL to
# `<HOSTED_AGENTS_URL>/invocations`, so the value here must end at
# `/endpoint/protocols`. Format:
#   https://<account>.services.ai.azure.com/api/projects/<project>/agents/<agent>/endpoint/protocols
HOSTED_AGENTS_URL=
HOSTED_AGENTS_PROJECT_NAME=
HOSTED_AGENTS_AGENT_NAME=tac-agent-framework

# ---- azd-required envs that Hosted Agents needs ------------------------
# These aren't auto-discovered by azd for `host: azure.ai.agent`. Set
# them explicitly or `azd up`/`azd deploy` will fail with a misleading
# error. All three are visible in the Foundry portal once the project
# exists.
#
# Resource ID of the Foundry project (subscription path).
AZURE_AI_PROJECT_ID=/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<account>/projects/<project>
# Foundry project endpoint (no trailing slash).
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
# ACR the Foundry account uses to store agent images.
AZURE_CONTAINER_REGISTRY_ENDPOINT=<account-acr>.azurecr.io

# ---- Key Vault: pick one mode ------------------------------------------
# Mode A (default) — Bicep creates a new vault. Leave EXISTING_* empty;
# TWILIO_AUTH_TOKEN above will be used to seed the secret.
# Optionally override the auto-generated vault name:
KEY_VAULT_NAME=

# Mode B — reuse an existing vault. Set the name (and RG if it's not in
# the deployment RG). The vault must already contain a secret named
# `TwilioAuthToken`. When set, KEY_VAULT_NAME and TWILIO_AUTH_TOKEN are
# ignored by Bicep.
EXISTING_KEY_VAULT_NAME=
EXISTING_KEY_VAULT_RESOURCE_GROUP=

# Set to true when reusing a vault where APIM's MI already has the
# `Key Vault Secrets User` role granted (Azure rejects duplicate
# (principal, role, scope) triples even with different role-assignment
# GUIDs, so a re-run will fail unless this is set).
SKIP_KEY_VAULT_ROLE_ASSIGNMENT=false

# Some tenants enforce purge protection on Key Vaults via Azure Policy.
# Defaults to true (compatible with strict tenants). Once enabled, the
# vault has the full 90-day soft-delete retention and CANNOT be purged
# early. Set to false only in dev tenants where you want fast teardown.
KEY_VAULT_PURGE_PROTECTION=true
