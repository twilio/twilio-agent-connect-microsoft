<!--
  APIM policy — Twilio Conversation Relay WSS upgrade → Hosted Agents
  /invocations_ws.

  Per Twilio docs (https://www.twilio.com/docs/voice/conversationrelay/onboarding):
    "Conversation Relay includes an X-Twilio-Signature header in the
     initial WebSocket handshake request. Use your Twilio auth token
     and the request URL to validate this signature."

  The CR WSS handshake HMAC is URL-only (same algorithm as a JSON POST
  with no body), mirroring sms-policy.xml.

    1. Validate X-Twilio-Signature against the upgrade URL with scheme
       rewritten wss → https. (Twilio's RequestValidator always rewrites
       wss/ws → https/http before signing — see
       https://github.com/twilio/twilio-python/blob/main/twilio/request_validator.py.)
    2. Confirm agent_session_id is on the upgrade query (the agent put
       it in the TwiML wss URL emitted by /twiml).
    3. Inject Foundry project_name, agent_name, api-version=v1, and the
       Foundry-Features header. Project + agent names are baked in at
       Bicep deploy time via __PROJECT_NAME__ / __AGENT_NAME__ tokens.
    4. Strip X-Twilio-Signature; rewrite path to the Foundry
       /invocations_ws route.

  WebSocket APIs require the policy to attach to the auto-created
  `onHandshake` operation (not the API scope) — handled in main.bicep.
-->
<policies>
  <inbound>
    <base />

    <!-- 1. URL-only HMAC. Mirror of sms-policy.xml step 1, except for
         the scheme rewrite. -->
    <set-variable name="twilioSignatureHeader" value="@(context.Request.Headers.GetValueOrDefault(&quot;X-Twilio-Signature&quot;, &quot;&quot;))" />
    <choose>
      <when condition="@(string.IsNullOrEmpty((string)context.Variables[&quot;twilioSignatureHeader&quot;]))">
        <return-response>
          <set-status code="401" reason="Missing X-Twilio-Signature" />
        </return-response>
      </when>
    </choose>
    <!-- APIM sees scheme=https in OriginalUrl after TLS termination,
         but Twilio signs the wss:// URL it dialed (the URL exactly as
         it appeared in TwiML Connect.ConversationRelay.url). So
         rewrite https → wss for signature computation. -->
    <set-variable name="twilioFullUrl" value="@{
        var u = context.Request.OriginalUrl;
        var qs = u.QueryString ?? &quot;&quot;;
        var scheme = (u.Scheme == &quot;https&quot;) ? &quot;wss&quot; : ((u.Scheme == &quot;http&quot;) ? &quot;ws&quot; : u.Scheme);
        return scheme + &quot;://&quot; + u.Host + u.Path + qs;
    }" />
    <set-variable name="twilioComputedSig" value="@{
        var key = System.Text.Encoding.UTF8.GetBytes(&quot;{{TwilioAuthToken}}&quot;);
        using (var hmac = new System.Security.Cryptography.HMACSHA1(key)) {
            var bytes = System.Text.Encoding.UTF8.GetBytes((string)context.Variables[&quot;twilioFullUrl&quot;]);
            return Convert.ToBase64String(hmac.ComputeHash(bytes));
        }
    }" />
    <choose>
      <when condition="@((string)context.Variables[&quot;twilioComputedSig&quot;] != (string)context.Variables[&quot;twilioSignatureHeader&quot;])">
        <return-response>
          <set-status code="401" reason="Invalid X-Twilio-Signature" />
          <set-header name="X-Debug-Computed-Sig" exists-action="override">
            <value>@((string)context.Variables["twilioComputedSig"])</value>
          </set-header>
          <set-header name="X-Debug-Expected-Sig" exists-action="override">
            <value>@((string)context.Variables["twilioSignatureHeader"])</value>
          </set-header>
          <set-header name="X-Debug-Url" exists-action="override">
            <value>@((string)context.Variables["twilioFullUrl"])</value>
          </set-header>
        </return-response>
      </when>
    </choose>

    <!-- 2. agent_session_id must already be on the upgrade URL (the
         agent put it there in the TwiML wss URL).
         NOTE: context.Request.Url.Query.GetValueOrDefault(...) was
         returning empty for the WS onHandshake operation even when the
         query was clearly present. Workaround: parse QueryString
         manually. -->
    <set-variable name="agentSessionId" value="@{
        var qs = context.Request.OriginalUrl.QueryString ?? string.Empty;
        if (qs.StartsWith(&quot;?&quot;)) {
            qs = qs.Substring(1);
        }
        foreach (var seg in qs.Split('&amp;')) {
            var eq = seg.IndexOf('=');
            if (eq &lt; 0) {
                continue;
            }
            var k = seg.Substring(0, eq);
            if (k == &quot;agent_session_id&quot;) {
                return System.Net.WebUtility.UrlDecode(seg.Substring(eq + 1));
            }
        }
        return string.Empty;
    }" />
    <choose>
      <when condition="@(string.IsNullOrEmpty((string)context.Variables[&quot;agentSessionId&quot;]))">
        <return-response>
          <set-status code="400" reason="Missing agent_session_id query parameter" />
        </return-response>
      </when>
    </choose>

    <!-- 3. Inject project_name + agent_name + api-version per Foundry's
         WSS endpoint URL contract. The HTTP /invocations endpoint
         encodes these in the path (.../agents/<agent>/endpoint/...),
         but the WSS /invocations_ws endpoint takes them as query
         parameters on a generic /api/projects/agents/endpoint/protocols/invocations_ws
         route. API version here is `v1`, not the dated preview string. -->
    <set-query-parameter name="project_name" exists-action="override">
      <value>__PROJECT_NAME__</value>
    </set-query-parameter>
    <set-query-parameter name="agent_name" exists-action="override">
      <value>__AGENT_NAME__</value>
    </set-query-parameter>
    <set-query-parameter name="api-version" exists-action="override">
      <value>v1</value>
    </set-query-parameter>

    <!-- 4. Inject Foundry auth + feature flag on the upgrade -->
    <authentication-managed-identity resource="https://ai.azure.com" />
    <set-header name="Foundry-Features" exists-action="override">
      <value>HostedAgents=V1Preview</value>
    </set-header>

    <!-- 5. Strip Twilio signature; rewrite path to the generic
         invocations_ws route on the Foundry backend. -->
    <set-header name="X-Twilio-Signature" exists-action="delete" />
    <rewrite-uri template="/api/projects/agents/endpoint/protocols/invocations_ws" />
  </inbound>

  <backend>
    <base />
  </backend>

  <outbound>
    <base />
  </outbound>

  <on-error>
    <base />
  </on-error>
</policies>
