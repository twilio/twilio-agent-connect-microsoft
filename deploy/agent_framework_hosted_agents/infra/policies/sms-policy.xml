<!--
  Twilio Conversation Orchestrator → Hosted Agents /invocations.

  Inbound:
    1. HMAC-validate X-Twilio-Signature against the request URL (CO
       webhooks are JSON; Twilio signs URL only, no body). Secret comes
       from the TwilioAuthToken named value (Key Vault reference).
    2. Lift data.conversationId from the body onto ?agent_session_id=
       so Hosted Agents pins this request and its retries to one sandbox.
    3. Inject an Entra bearer via APIM's system-assigned managed
       identity (resource = https://ai.azure.com).
    4. Strip X-Twilio-Signature (invalid after rewrite); preserve
       i-twilio-idempotency-token (the agent uses it for dedup).
-->
<policies>
  <inbound>
    <base />

    <!-- 1. Twilio signature validation -->
    <set-variable name="twilioSignatureHeader" value="@(context.Request.Headers.GetValueOrDefault(&quot;X-Twilio-Signature&quot;, &quot;&quot;))" />
    <choose>
      <when condition="@(string.IsNullOrEmpty((string)context.Variables[&quot;twilioSignatureHeader&quot;]))">
        <return-response>
          <set-status code="401" reason="Missing X-Twilio-Signature" />
        </return-response>
      </when>
    </choose>
    <set-variable name="twilioFullUrl" value="@{
        var u = context.Request.OriginalUrl;
        var qs = u.QueryString ?? &quot;&quot;;
        return u.Scheme + &quot;://&quot; + u.Host + u.Path + qs;
    }" />
    <set-variable name="twilioComputedSig" value="@{
        var key = System.Text.Encoding.UTF8.GetBytes(&quot;{{TwilioAuthToken}}&quot;);
        using (var hmac = new System.Security.Cryptography.HMACSHA1(key)) {
          var bytes = System.Text.Encoding.UTF8.GetBytes((string)context.Variables[&quot;twilioFullUrl&quot;]);
          return Convert.ToBase64String(hmac.ComputeHash(bytes));
        }
    }" />
    <choose>
      <when condition="@((string)context.Variables[&quot;twilioComputedSig&quot;] != (string)context.Variables[&quot;twilioSignatureHeader&quot;])">
        <!-- To debug a signature mismatch, inspect twilioComputedSig /
             twilioFullUrl via the APIM trace console (Ocp-Apim-Trace) or
             App Insights — never echo the computed HMAC back to the caller. -->
        <return-response>
          <set-status code="401" reason="Invalid X-Twilio-Signature" />
        </return-response>
      </when>
    </choose>

    <!-- 2. Map CO conversationId -> agent_session_id query param. -->
    <set-variable name="conversationId" value="@{
        var body = context.Request.Body.As&lt;Newtonsoft.Json.Linq.JObject&gt;(preserveContent: true);
        if (body == null) { return (string)null; }
        var data = body[&quot;data&quot;] as Newtonsoft.Json.Linq.JObject;
        if (data == null) { return (string)null; }
        return (string)(data[&quot;conversationId&quot;] ?? data[&quot;id&quot;]);
    }" />
    <choose>
      <when condition="@(string.IsNullOrEmpty((string)context.Variables[&quot;conversationId&quot;]))">
        <return-response>
          <set-status code="400" reason="Missing conversationId in body" />
        </return-response>
      </when>
    </choose>
    <set-query-parameter name="agent_session_id" exists-action="override">
      <value>@((string)context.Variables["conversationId"])</value>
    </set-query-parameter>
    <set-query-parameter name="api-version" exists-action="override">
      <value>2025-11-15-preview</value>
    </set-query-parameter>

    <!-- 3. Inject Entra bearer for Hosted Agents -->
    <authentication-managed-identity resource="https://ai.azure.com" />

    <!-- 4. Strip Twilio signature (no longer valid after URL rewrite) -->
    <set-header name="X-Twilio-Signature" exists-action="delete" />

    <set-backend-service backend-id="hosted-agents-backend" />
    <rewrite-uri template="/invocations" />
  </inbound>

  <backend>
    <base />
  </backend>

  <outbound>
    <base />
  </outbound>

  <on-error>
    <base />
  </on-error>
</policies>
